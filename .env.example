# Postgres connection string — a local Postgres or a free Neon (https://neon.tech) project both work.
# Example Neon format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arctic_blocks?schema=public"

# NextAuth (Auth.js) session signing secret — also signs the PDF/share
# tokens. Rotating it signs everyone out and revokes shared invoice links.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The site's own address, used for links in emails and for the PDF renderer
# to reach /print/* pages when no request host is available (cron jobs).
AUTH_URL="http://localhost:3000"

# Platform admin login for /admin — one fixed identity from these two vars,
# never a database row and never part of any company. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Next.js expands "$VAR" in .env files, which corrupts a bcrypt hash (it starts
# with "$2b$10$...") — escape every "$" as "\$" in this file. That escaping is
# for .env files ONLY: in a host's env-var UI (Vercel etc.) paste the RAW hash.
# (src/auth.ts also strips stray "\$" defensively.)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Set to 1 to close public sign-up (/signup); companies can then only be
# added from /admin or `npm run create-company`.
SIGNUPS_DISABLED=""

# Outgoing mail for the "forgot password" flow. Optional in development —
# with SMTP_HOST unset, reset links are logged to the server console instead
# of emailed, so the flow is still fully testable locally.
# Any SMTP provider works (Gmail app password, SendGrid, Postmark, Mailgun, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Product/company/signature image uploads (src/lib/uploads.ts). Unset in local
# dev, which writes straight to public/uploads/ on disk instead. On Vercel (or
# any serverless host) that disk write fails — the filesystem there is
# read-only outside /tmp, which isn't served publicly or kept between
# invocations — so a Vercel deployment MUST have this set or every image
# upload throws "ENOENT: ... mkdir '/var/task/public/uploads'". Get a value by
# adding a Blob store to the Vercel project (Storage tab → Create Database →
# Blob → Connect to Project) — this env var is then auto-injected into every
# environment (Production/Preview/Development) and never needs to be typed in
# by hand.
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron — required by /api/cron/backup (nightly per-company backups,
# 03:00 IST), /api/cron/daily (8 AM summary email to each company's owners)
# and /api/cron/warm. Any long random string; Vercel sends it as a Bearer token.
CRON_SECRET=""

# ── Platform admin two-factor (optional, recommended) ────────────────────────
# With this set, /admin/login also asks for a 6-digit authenticator code.
# Generate it (and a QR code to scan) with: npm run admin-totp
ADMIN_TOTP_SECRET=""

# ── Subscriptions: Razorpay online payment (optional) ────────────────────────
# Without these, plans are changed and payments recorded by the platform admin
# in /admin. Webhook: Razorpay Dashboard → Webhooks → <site>/api/billing/razorpay,
# events payment.captured + order.paid, with RAZORPAY_WEBHOOK_SECRET as its secret.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Signup bot check: Cloudflare Turnstile (optional) ────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Error alerts (optional) ──────────────────────────────────────────────────
# A Slack / Google Chat / Discord incoming-webhook URL; every server error is
# posted there (at most once per 10 minutes per message). Errors are always
# logged as JSON lines regardless. Uptime monitors can watch /api/health.
ERROR_WEBHOOK_URL=""

