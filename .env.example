# Postgres connection string — a local Postgres or a free Neon (https://neon.tech) project both work.
# Example Neon format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arctic_blocks?schema=public"

# NextAuth (Auth.js) session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Super-admin login for /admin — not a database row. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Next.js expands "$VAR" in .env files, which corrupts a bcrypt hash (it starts
# with "$2b$10$...") — escape every "$" as "\$" or the hash will silently break.
# This "\$" escaping is a LOCAL .env-FILE-ONLY requirement. When pasting this
# value into a host's dashboard env-var UI (Vercel, Netlify, etc.), paste the
# RAW hash with no backslashes — those dashboards don't unescape "\$" the way
# Next's local .env loader does, so a verbatim copy-paste silently breaks admin
# login in production. (src/auth.ts also strips stray "\$" defensively, but
# don't rely on that — enter the raw hash on every host.)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Outgoing mail for the "forgot password" flow. Optional in development —
# with SMTP_HOST unset, reset links are logged to the server console instead
# of emailed, so the flow is still fully testable locally.
# Any SMTP provider works (Gmail app password, SendGrid, Postmark, Mailgun, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Product/company/signature image uploads (src/lib/uploads.ts). Unset in local
# dev, which writes straight to public/uploads/ on disk instead. On Vercel (or
# any serverless host) that disk write fails — the filesystem there is
# read-only outside /tmp, which isn't served publicly or kept between
# invocations — so a Vercel deployment MUST have this set or every image
# upload throws "ENOENT: ... mkdir '/var/task/public/uploads'". Get a value by
# adding a Blob store to the Vercel project (Storage tab → Create Database →
# Blob → Connect to Project) — this env var is then auto-injected into every
# environment (Production/Preview/Development) and never needs to be typed in
# by hand.
BLOB_READ_WRITE_TOKEN=""
