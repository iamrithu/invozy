// ASB — Prisma schema
// Single-company deployment: exactly one Company row (id "main", created by
// `npm run setup` — see scripts/setup-company.ts), and every product,
// customer, and invoice belongs to it implicitly, so none of them carry a
// companyId.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  // Fixed id — the primary-key constraint is what keeps this a singleton.
  // Must match COMPANY_ID in src/lib/company-id.ts.
  id                  String          @id @default("main")
  name                String
  domain              String?
  // Nullable — the setup script only requires name + state; the rest is
  // filled in later via the Company settings page. Every reader already
  // null-guards these.
  address             String?
  state               String
  district            String?
  gstin               String?
  pan                 String?
  phone               String?
  altPhone            String?
  email               String?
  bankName            String?
  bankAcc             String?
  ifsc                String?
  branch              String?
  upi                 String?
  // Two independent opt-ins for the payment block near the Authorised
  // Signatory section on the invoice PDF — a company can show neither, just
  // one, or both together: a scannable UPI QR generated from `upi` (see
  // src/lib/qr.ts's upiQrDataUrl), and/or this company's own `phone` printed
  // as a GPay-reachable number.
  showUpiQr           Boolean         @default(false)
  showGpayNumber      Boolean         @default(false)
  cgstRate            Decimal         @default(9)
  sgstRate            Decimal         @default(9)
  igstRate            Decimal         @default(18)
  cgstEnabled         Boolean         @default(true)
  sgstEnabled         Boolean         @default(true)
  igstEnabled         Boolean         @default(true)
  invoicePrefix       String          @default("INV")
  invoiceFY           String
  nextInvoiceNo       Int             @default(1)
  terms               String?
  logoUrl             String?
  themeColor          String          @default("red")
  // Symbol-only — what prints on invoices/amounts (fmtInr in src/lib/gst.ts).
  // GST math (CGST/SGST/IGST) always stays India-specific regardless of this.
  currency            String          @default("INR")
  // PDF-handling toggles — what shows on the generated invoice PDF, read by
  // both invoice-sheet.tsx (MODERN) and invoice-sheet-classic.tsx (CLASSIC).
  pdfShowBankDetails  Boolean         @default(true)
  // Per-HSN-code tax breakdown table (CLASSIC only) — off by default since
  // most businesses don't need this granularity on the printed invoice;
  // the calculation (computeHsnSummary in src/lib/gst.ts) stays available.
  pdfShowHsnSummary   Boolean         @default(false)
  // Whether the PDF prints discounts. Off only hides them — totals are
  // still worked out with every discount, and the printed rates/amounts
  // already have the hidden discount taken off so each row still adds up.
  pdfShowItemDiscount Boolean         @default(true)
  pdfShowBillDiscount Boolean         @default(true)
  // Fallback HSN/SAC code used whenever a line item has neither its own nor
  // its product's own HSN set — replaces src/lib/gst.ts's old hardcoded
  // '21050000' constant with a per-company value, since not every business
  // on this app sells edible ice. A product's own Product.hsn (or a line's
  // own override) always wins over this; this only fills the gap when
  // neither is set.
  defaultHsn          String          @default("21050000")
  createdAt           DateTime        @default(now())
  // GST-compliance seller details — needed to render/generate a CLASSIC
  // (Tally-style) invoice and to populate SellerDtls in the e-Invoice/e-Way
  // Bill NIC API payloads.
  fssaiNo             String?
  pincode             String?
  invoiceTemplate     InvoiceTemplate @default(MODERN)
  // Printed on the CLASSIC template's Authorised Signatory row — optional,
  // so it stays blank (for physical signing) until the owner sets these.
  signatoryName       String?
  signatureUrl        String?
  // NIC e-Invoice / e-Way Bill sandbox (or production) API credentials —
  // GST filing happens under this company's own GSTIN. Password/secret are encrypted at rest via src/lib/secret.ts, never the
  // raw value — see src/actions/company.ts.
  nicSandbox          Boolean         @default(true)
  nicUsername         String?
  nicPasswordEnc      String?
  nicClientId         String?
  nicClientSecretEnc  String?
  // Bumped on every profile/branding/template change — part of each stored
  // invoice PDF's cache key (see src/lib/invoice-pdf.ts), so a new logo or
  // template makes every cached PDF stale without touching the invoices.
  updatedAt           DateTime        @default(now()) @updatedAt
  // Credit notes and payment receipts get their own sequential numbers,
  // claimed the same way as invoice numbers (claimInvoiceNumber).
  creditNotePrefix    String          @default("CN")
  nextCreditNoteNo    Int             @default(1)
  receiptPrefix       String          @default("RCPT")
  nextReceiptNo       Int             @default(1)
  // Inventory tuning — how many days of sales a reorder should cover, and
  // how far ahead a batch's expiry date starts showing as "expiring soon".
  reorderLeadDays     Int             @default(7)
  expiryAlertDays     Int             @default(30)
  // Ledger names the Tally XML export posts to — must match the ledgers in
  // the accountant's Tally company. Null = the defaults in src/lib/tally.ts.
  tallyLedgers        Json?
}

/// A login for the company — created only by `npm run setup` (there is no
/// in-app signup). Every user has full access to the one company.
model User {
  id                String               @id @default(cuid())
  email             String?              @unique
  phone             String?              @unique
  passwordHash      String
  createdAt         DateTime             @default(now())
  onboardedAt       DateTime?
  resetTokens       PasswordResetToken[]
  // OWNER (everyone created by `npm run setup`) can do everything; STAFF
  // can bill, take payments and receive stock, but can't delete, change
  // company settings or manage logins — see src/lib/session.ts requireOwner.
  name              String?
  role              UserRole             @default(OWNER)
  active            Boolean              @default(true)
  activities        ActivityLog[]
  movements         StockMovement[]
  notificationReads NotificationRead[]
  refunds           Refund[]
}

/// One row per login identifier (email/phone) — tracks recent failures so repeated wrong passwords lock the identifier
/// out for a cooldown instead of allowing unlimited brute-force attempts.
model LoginAttempt {
  identifier  String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Self-serve "forgot password" tokens — single-use, short-lived, always
/// tied to one User.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Product {
  id            String             @id @default(cuid())
  name          String
  category      String
  unit          String
  price         Decimal
  packQty       Int?
  active        Boolean            @default(true)
  desc          String?
  images        String[]           @default([])
  // HSN/SAC code — snapshotted onto InvoiceItem at invoice-creation time
  // (see InvoiceItem.hsn), needed for the CLASSIC template's item table,
  // HSN-wise tax summary, and the e-Invoice ItemList payload.
  hsn           String?
  // Secondary-quantity conversion for the CLASSIC template's optional extra
  // quantity column (e.g. a sample invoice showing "40 Box" also as
  // "32 Litres") — altQtyPerUnit is per one `unit` (e.g. per box), snapshotted
  // onto InvoiceItem same as hsn/batch. Both null unless the business uses
  // a secondary unit of measure.
  altUnit       String?
  altQtyPerUnit Decimal?
  // Default line discount % — a new invoice line for this product starts
  // at it (still editable per line). 0 = no discount.
  discount      Decimal            @default(0)
  invoiceItems  InvoiceItem[]
  // Additional unit+price pricing options for this same product (e.g. sold
  // as a Box at one price with a minimum order quantity, and as a loose
  // Piece at a plain price) — `unit`/`price` above stay the "primary" pair
  // used by dashboard/reports/list views; the invoice builder reads
  // `priceTiers` to offer every pricing option. See src/actions/products.ts.
  priceTiers    ProductPriceTier[]

  // Inventory — always counted in this product's main `unit` (the first
  // price tier). Off by default so products that were never counted don't
  // block billing; entering a first count on the Inventory screen turns it
  // on. `stockQty` is a cached running balance — StockMovement is the
  // ledger it's derived from, and every change goes through
  // src/lib/stock.ts's applyMovement so the two never disagree.
  trackStock     Boolean          @default(false)
  stockQty       Decimal          @default(0)
  lowStockAt     Decimal?
  stockMovements StockMovement[]
  customerPrices CustomerPrice[]
  schemes        Scheme[]
  purchaseItems  PurchaseItem[]
  creditItems    CreditNoteItem[]

  @@index([category, name])
  @@index([active])
}

model ProductPriceTier {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      String
  price     Decimal
  // Approximate quantity of the catalog's base unit this tier's own unit
  // represents (e.g. "1 Box ≈ 40 Piece") — purely informational, used only
  // to derive a per-piece price for comparison (price / approxQty). Never a
  // purchase minimum: adding a Box to an invoice always starts at qty 1,
  // and InvoiceItem never needs to know about this at all.
  approxQty Decimal?
  sortOrder Int      @default(0)

  @@index([productId])
}

model Customer {
  id          String          @id @default(cuid())
  name        String
  shopName    String?
  contact     String?
  phone       String?
  altPhone    String?
  email       String?
  state       String
  district    String?
  gstin       String?
  address     String?
  terms       String          @default("Due on receipt")
  creditLimit Decimal         @default(0)
  guest       Boolean         @default(false)
  // Buyer-block fields for the CLASSIC template + e-Invoice BuyerDtls/ShipDtls
  // — `contact`/`phone` above already cover "Contact person"/"Contact".
  fssaiNo     String?
  pincode     String?
  invoices    Invoice[]
  // Disabled customers keep all their history but drop out of the Bill To
  // picker and the active directory — the safe alternative to deleting a
  // customer who has invoices on file.
  active      Boolean         @default(true)
  images      String[]        @default([])
  // Delivery route/beat — groups the daily loading sheet.
  route       String?
  // Part of each invoice PDF's cache key — the buyer block reads the live
  // customer row, so editing an address must invalidate stored PDFs.
  updatedAt   DateTime        @default(now()) @updatedAt
  prices      CustomerPrice[]
  creditNotes CreditNote[]

  @@index([guest, name])
  @@index([active, name])
}

/// A customer-specific price for one product+unit, used by the invoice
/// builder in place of the catalog price for this customer.
model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit       String
  price      Decimal

  @@unique([customerId, productId, unit])
  @@index([productId])
}

/// "Buy N, get M free" on one product+unit — the builder suggests the free
/// line (rate 0) once a line's quantity reaches `buyQty`.
model Scheme {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String?
  unit      String
  buyQty    Decimal
  freeQty   Decimal
  active    Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?
  createdAt DateTime  @default(now())

  @@index([productId])
}

model Invoice {
  id                   String        @id @default(cuid())
  number               String        @unique
  date                 DateTime
  due                  DateTime
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  status               InvoiceStatus @default(DRAFT)
  overallDiscountType  DiscountType  @default(PERCENT)
  overallDiscountValue Decimal       @default(0)
  // Free-text, per-invoice (unlike Company.terms, which is the same on every
  // invoice) — notes prints near the totals/declaration, deliveryInstructions
  // repeats in the buyer block since it's what the delivery crew needs to see.
  notes                String?
  deliveryInstructions String?
  // Informal transport/delivery reference (who's driving, what vehicle) —
  // printed in a box before Delivery Instructions on the CLASSIC template,
  // enabled per invoice from the builder's Settings sheet. Deliberately its
  // own fields, not a reuse of the e-Way Bill compliance columns below
  // (vehicleNo/transporterName/etc.): those feed an actual NIC submission
  // and have their own dedicated entry flow, while this is just informal
  // print/reference text a business can fill in without generating a real
  // e-Way Bill. Shown only when showTransportDetails is on AND at least one
  // of the three fields is actually filled in — enabling it with nothing
  // entered prints nothing rather than an empty box.
  showTransportDetails Boolean       @default(false)
  transportVehicleNo   String?
  transportDriverName  String?
  transportDriverPhone String?

  // GST config + PDF section visibility, SNAPSHOTTED at create/update time
  // from either Company's then-current defaults or a per-invoice override
  // entered via the builder's Settings sheet — NEVER re-read from Company
  // after that. This is what makes an already-issued invoice's totals and
  // printed sections immune to a later change in Company.cgstRate/
  // cgstEnabled/pdfShowBankDetails/etc. Every invoice-facing computeTotals()
  // call and every PDF section-visibility check should read these fields,
  // never the live Company columns of the same name. Deliberately named
  // without a "pdfShow" prefix (unlike Company.pdfShowBankDetails/
  // pdfShowHsnSummary) so it's visually obvious in code which is the live
  // company default vs. the frozen per-invoice snapshot. Pre-migration rows
  // are backfilled from Company's values at migration time (see
  // 20260921_add_invoice_gst_snapshot/migration.sql), which is only an
  // approximation for any invoice whose company GST config changed since it
  // was originally created — the true historical value was never recorded
  // before this feature.
  cgstRate        Decimal @default(9)
  sgstRate        Decimal @default(9)
  igstRate        Decimal @default(18)
  cgstEnabled     Boolean @default(true)
  sgstEnabled     Boolean @default(true)
  igstEnabled     Boolean @default(true)
  showBankDetails Boolean @default(true)
  showHsnSummary  Boolean @default(false)
  // Same snapshot treatment as the fields above, for the UPI QR / GPay
  // number shown near the Authorised Signatory block — see Company.
  // showUpiQr/showGpayNumber for what each one renders.
  showUpiQr       Boolean @default(false)
  showGpayNumber  Boolean @default(false)

  // Computed totals, STORED — written by every action that changes an
  // invoice's lines, discount, GST snapshot, customer, or payments (see
  // src/lib/invoice-totals.ts). computeTotals() in src/lib/gst.ts is still
  // the only place this math lives; these columns just cache its result so
  // the dashboard, reports, invoice list (amount sort/filter, GST-type
  // filter), and customer ledgers can aggregate in SQL instead of loading
  // every invoice with all its items and payments into memory.
  // `interState` is computeTotals' `useIgst` (IGST vs CGST+SGST).
  taxable    Decimal @default(0)
  cgst       Decimal @default(0)
  sgst       Decimal @default(0)
  igst       Decimal @default(0)
  total      Decimal @default(0)
  interState Boolean @default(false)
  amountPaid Decimal @default(0)

  items     InvoiceItem[]
  payments  Payment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // The stored PDF (Vercel Blob URL, or a local cache path in dev) and the
  // hash of everything it was rendered from — see src/lib/invoice-pdf.ts.
  // A mismatch means the PDF is stale and gets rebuilt on next request.
  pdfUrl         String?
  pdfKey         String?
  // Last WhatsApp payment reminder sent from the app, for "reminded 2 days
  // ago" on overdue invoices.
  lastRemindedAt DateTime?
  stockMovements StockMovement[]
  creditNotes    CreditNote[]
  // Whether this invoice has taken its lines out of stock. Every save does
  // — drafts included — so this is only false on drafts saved before drafts
  // took stock (set by the 20261101000000 migration): those hold nothing,
  // and take their stock the next time they're saved, sent or paid.
  stockTaken     Boolean         @default(true)

  // e-Invoice (NIC IRP) result — see src/lib/nic/einvoice.ts.
  irn            String?
  ackNo          String?
  ackDate        DateTime?
  signedQrCode   String?        @db.Text
  einvoiceStatus EinvoiceStatus @default(NOT_GENERATED)
  einvoiceError  String?

  // e-Way Bill inputs (user-entered transport details) + NIC result — see
  // src/lib/nic/ewaybill.ts. Independent of e-Invoice — a business can owe
  // an e-Way Bill without being e-Invoice-mandated, and vice versa.
  vehicleNo          String?
  transporterId      String?
  transporterName    String?
  transporterDocNo   String?
  transporterDocDate DateTime?
  transportMode      TransportMode  @default(ROAD)
  distanceKm         Int?
  ewbNo              String?
  ewbDate            DateTime?
  ewbValidUpto       DateTime?
  ewaybillStatus     EwaybillStatus @default(NOT_GENERATED)
  ewbError           String?

  // Standard Tally-style reference fields shown on the CLASSIC invoice's
  // header grid — all optional, blank unless the business fills them in via
  // "Edit dispatch details" (see src/actions/invoices.ts's
  // updateDispatchDetails). None of these feed GST math or the NIC payload;
  // they're print/reference fields only.
  deliveryNote     String?
  deliveryNoteDate DateTime?
  buyersOrderNo    String?
  buyersOrderDate  DateTime?
  dispatchDocNo    String?
  otherReferences  String?
  billOfLadingNo   String?
  destination      String?

  @@index([date])
  @@index([status, due])
  @@index([customerId, date])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Nullable — an ad-hoc/custom line item (not from the product catalog)
  // has no backing Product row. `name`/`unit`/`rate` are always
  // snapshotted here regardless, so nothing ever needs to read through
  // this relation to render an invoice.
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  name          String
  unit          String
  qty           Decimal
  rate          Decimal
  discount      Decimal  @default(0)
  // Snapshotted at invoice-creation time, same convention as name/unit/rate
  // above — CLASSIC template + HSN-wise tax summary + e-Invoice ItemList.
  hsn           String?
  batch         String?
  // Snapshotted from Product.altUnit/altQtyPerUnit — see that field's comment.
  altUnit       String?
  altQtyPerUnit Decimal?
  // How much of the product's main stock unit this line consumes (qty ×
  // unit factor, e.g. 6 Piece of a 12-per-Box product = 0.5), fixed at save
  // time so a later change to the product's units can't rewrite history.
  // Null for ad-hoc lines and untracked products.
  stockQty      Decimal?

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal
  date         DateTime
  mode         String?
  // UPI transaction id, cheque number, bank reference…
  reference    String?
  // Sequential receipt number (Company.receiptPrefix/nextReceiptNo) —
  // null for payments recorded before receipts existed.
  receiptNo    String?     @unique
  // Set when this "payment" is really a credit note applied against an
  // invoice — its own invoice when it's raised, and any other unpaid
  // invoice of the customer's it's later adjusted against. Deleting the
  // credit note removes them all.
  creditNoteId String?
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([invoiceId])
  @@index([date])
  @@index([creditNoteId])
}

/// The inventory ledger — one row per change to a product's stock, always
/// in the product's main unit. `qty` is signed (+ in, − out) and
/// `balanceAfter` is Product.stockQty right after this row was applied.
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          StockMovementType
  qty           Decimal
  balanceAfter  Decimal
  // Source documents — SetNull so deleting a document keeps the history
  // row (its own reversal row is posted first); `invoiceNumber` keeps the
  // human reference readable after the invoice itself is gone.
  invoiceId     String?
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  purchaseId    String?
  purchase      Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  creditNoteId  String?
  creditNote    CreditNote?       @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  reference     String?
  unitCost      Decimal?
  note          String?
  // Batch/expiry of stock coming in (OPENING/PURCHASE) — which batches are
  // still on hand is derived first-in-first-out, see src/lib/stock.ts.
  batchNo       String?
  expiryDate    DateTime?
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([productId, date])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([creditNoteId])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  gstin     String?
  state     String?
  address   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  purchases Purchase[]

  @@index([active, name])
}

/// A supplier bill — posting it adds stock (PURCHASE movements) and records
/// the input GST paid. Totals are stored, same convention as Invoice.
model Purchase {
  id             String               @id @default(cuid())
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  billNo         String?
  date           DateTime
  notes          String?
  taxable        Decimal              @default(0)
  cgst           Decimal              @default(0)
  sgst           Decimal              @default(0)
  igst           Decimal              @default(0)
  total          Decimal              @default(0)
  items          PurchaseItem[]
  stockMovements StockMovement[]
  attachments    PurchaseAttachment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  @@index([date])
  @@index([supplierId, date])
}

/// A file kept on a purchase for reference — the supplier's bill as a PDF,
/// photos of it or of the delivery. Never read for stock or GST. The file
/// itself lives in upload storage (src/lib/uploads.ts) at `url`; the
/// purchase actions delete it when it's removed from the bill or the bill
/// is deleted.
model PurchaseAttachment {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  url         String
  // The file's original name, for the list ("CM-7802.pdf").
  name        String
  contentType String
  size        Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

model PurchaseItem {
  id         String    @id @default(cuid())
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  unit       String
  qty        Decimal
  rate       Decimal
  gstRate    Decimal   @default(0)
  stockQty   Decimal?
  batchNo    String?
  expiryDate DateTime?

  @@index([purchaseId])
  @@index([productId])
}

/// GST credit note against an invoice (goods returned or price corrected).
/// Its value is applied to the invoice as a Payment row (mode "Credit
/// note"), capped at the invoice's balance; anything beyond that is
/// `refundDue` — the customer's credit, later paid back (Refund rows) or
/// adjusted against another of their invoices (more Payment rows). What's
/// still open = total − its payments − its refunds. Lines marked `restock`
/// post SALE_RETURN movements.
model CreditNote {
  id              String           @id @default(cuid())
  number          String           @unique
  date            DateTime
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceNumber   String?
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  reason          String?
  restock         Boolean          @default(true)
  cgstRate        Decimal          @default(0)
  sgstRate        Decimal          @default(0)
  igstRate        Decimal          @default(0)
  interState      Boolean          @default(false)
  taxable         Decimal          @default(0)
  cgst            Decimal          @default(0)
  sgst            Decimal          @default(0)
  igst            Decimal          @default(0)
  total           Decimal          @default(0)
  refundDue       Decimal          @default(0)
  // Taken off the credit before GST — handling charges, or a deduction for
  // goods that came back used or damaged — with its reason, both printed.
  deduction       Decimal          @default(0)
  deductionReason String?
  items           CreditNoteItem[]
  payments        Payment[]
  refunds         Refund[]
  stockMovements  StockMovement[]
  createdAt       DateTime         @default(now())

  @@index([customerId, date])
  @@index([invoiceId])
  @@index([date])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  unit         String
  hsn          String?
  qty          Decimal
  rate         Decimal
  discount     Decimal    @default(0)
  stockQty     Decimal?
  // Share of the line's value credited — below 100 when the goods came
  // back used or damaged. 0 records a return that earns no credit.
  creditPct    Decimal    @default(100)
  // Whether these goods went back into sellable stock. One invoice line
  // can be returned as two rows: the good part restocked, the damaged
  // part not.
  restock      Boolean    @default(false)

  @@index([creditNoteId])
  @@index([productId])
}

/// Money paid back to a customer out of a credit note's open credit (cash,
/// UPI, bank…). Can't outlive its credit note — delete the refund first.
model Refund {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  amount       Decimal
  date         DateTime
  mode         String?
  reference    String?
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([creditNoteId])
  @@index([date])
}

/// Who did what — written by src/lib/activity.ts from the server actions.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
}

enum DiscountType {
  PERCENT
  FLAT
}

enum InvoiceTemplate {
  MODERN
  CLASSIC
  CLEAN
}

enum UserRole {
  OWNER
  STAFF
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT
  DAMAGE
}

enum EinvoiceStatus {
  NOT_GENERATED
  GENERATED
  CANCELLED
  FAILED
}

enum EwaybillStatus {
  NOT_GENERATED
  GENERATED
  CANCELLED
  FAILED
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

/// Which notification (src/actions/notifications.ts) each login has read,
/// at which signature — a notification's signature changes when the data
/// behind it changes (a new overdue invoice), which makes it unread again.
/// Per login, so the owner's phone and laptop agree on the badge.
model NotificationRead {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  signature      String
  readAt         DateTime @default(now())

  @@id([userId, notificationId])
}

/// Small company-wide settings that don't warrant their own Company column
/// (monthly sales target, PDF item-row style, daily summary opt-outs…) —
/// typed and defaulted in src/lib/settings.ts. A separate table rather than
/// new Company columns so a deploy that lands before `db:deploy` can't break
/// every Company query: code reading this table falls back to defaults.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}
