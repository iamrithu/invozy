// Arctic Blocks — Prisma schema
// Mirrors backend-documentation.md §2 exactly. Single-company assumption
// for now (see that doc's "Open Items" for the multi-tenant path).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String          @id @default(cuid())
  name               String
  domain             String?
  // Nullable — a brand-new signup doesn't have these yet; filled in later
  // via the Company settings page. See src/lib/get-company.ts callers,
  // which already null-guard everything here the same way domain/upi/terms
  // always have been.
  address            String?
  state              String
  district           String?
  gstin              String?
  pan                String?
  phone              String?
  altPhone           String?
  email              String?
  bankName           String?
  bankAcc            String?
  ifsc               String?
  branch             String?
  upi                String?
  cgstRate           Decimal         @default(9)
  sgstRate           Decimal         @default(9)
  igstRate           Decimal         @default(18)
  cgstEnabled        Boolean         @default(true)
  sgstEnabled        Boolean         @default(true)
  igstEnabled        Boolean         @default(true)
  invoicePrefix      String          @default("INV")
  invoiceFY          String
  nextInvoiceNo      Int             @default(1)
  terms              String?
  logoUrl            String?
  themeColor         String          @default("red")
  // Symbol-only — what prints on invoices/amounts (fmtInr in src/lib/gst.ts).
  // GST math (CGST/SGST/IGST) always stays India-specific regardless of this.
  currency           String          @default("INR")
  // PDF-handling toggles — what shows on the generated invoice PDF, read by
  // both invoice-sheet.tsx (MODERN) and invoice-sheet-classic.tsx (CLASSIC).
  pdfShowBankDetails Boolean         @default(true)
  // Per-HSN-code tax breakdown table (CLASSIC only) — off by default since
  // most businesses don't need this granularity on the printed invoice;
  // the calculation (computeHsnSummary in src/lib/gst.ts) stays available.
  pdfShowHsnSummary  Boolean         @default(false)
  createdAt          DateTime        @default(now())
  // GST-compliance seller details — needed to render/generate a CLASSIC
  // (Tally-style) invoice and to populate SellerDtls in the e-Invoice/e-Way
  // Bill NIC API payloads.
  fssaiNo            String?
  pincode            String?
  invoiceTemplate    InvoiceTemplate @default(MODERN)
  // Printed on the CLASSIC template's Authorised Signatory row — optional,
  // so it stays blank (for physical signing) until the owner sets these.
  signatoryName      String?
  signatureUrl       String?
  // NIC e-Invoice / e-Way Bill sandbox (or production) API credentials —
  // per-tenant, since GST filing happens under each tenant's own GSTIN.
  // Password/secret are encrypted at rest via src/lib/secret.ts, never the
  // raw value — see src/actions/company.ts.
  nicSandbox         Boolean         @default(true)
  nicUsername        String?
  nicPasswordEnc     String?
  nicClientId        String?
  nicClientSecretEnc String?
  users              User[]
  products           Product[]
  customers          Customer[]
  invoices           Invoice[]
}

model User {
  id           String               @id @default(cuid())
  email        String?              @unique
  phone        String?              @unique
  passwordHash String
  role         Role                 @default(OWNER)
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  createdAt    DateTime             @default(now())
  onboardedAt  DateTime?
  resetTokens  PasswordResetToken[]

  @@index([companyId])
}

/// One row per login identifier (email/phone, or the fixed admin email) —
/// tracks recent failures so repeated wrong passwords lock the identifier
/// out for a cooldown instead of allowing unlimited brute-force attempts.
model LoginAttempt {
  identifier  String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Self-serve "forgot password" tokens — single-use, short-lived, always
/// tied to one User (only tenant OWNERs have a User row; the super-admin
/// account lives in env vars and isn't part of this flow).
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  OWNER
  SUPER_ADMIN
}

model Product {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  name          String
  category      String
  unit          String
  price         Decimal
  packQty       Int?
  active        Boolean       @default(true)
  desc          String?
  images        String[]      @default([])
  // HSN/SAC code — snapshotted onto InvoiceItem at invoice-creation time
  // (see InvoiceItem.hsn), needed for the CLASSIC template's item table,
  // HSN-wise tax summary, and the e-Invoice ItemList payload.
  hsn           String?
  // Secondary-quantity conversion for the CLASSIC template's optional extra
  // quantity column (e.g. a sample invoice showing "40 Box" also as
  // "32 Litres") — altQtyPerUnit is per one `unit` (e.g. per box), snapshotted
  // onto InvoiceItem same as hsn/batch. Both null unless the business uses
  // a secondary unit of measure.
  altUnit       String?
  altQtyPerUnit Decimal?
  invoiceItems  InvoiceItem[]
  // Additional unit+price pricing options for this same product (e.g. sold
  // as a Box at one price with a minimum order quantity, and as a loose
  // Piece at a plain price) — `unit`/`price` above stay the "primary" pair
  // used by dashboard/reports/list views; the invoice builder reads
  // `priceTiers` to offer every pricing option. See src/actions/products.ts.
  priceTiers    ProductPriceTier[]

  @@index([companyId, category])
}

model ProductPriceTier {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      String
  price     Decimal
  // Approximate quantity of the catalog's base unit this tier's own unit
  // represents (e.g. "1 Box ≈ 40 Piece") — purely informational, used only
  // to derive a per-piece price for comparison (price / approxQty). Never a
  // purchase minimum: adding a Box to an invoice always starts at qty 1,
  // and InvoiceItem never needs to know about this at all.
  approxQty Decimal?
  sortOrder Int      @default(0)

  @@index([productId])
}

model Customer {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  shopName    String?
  contact     String?
  phone       String?
  altPhone    String?
  email       String?
  state       String
  district    String?
  gstin       String?
  address     String?
  terms       String    @default("Due on receipt")
  creditLimit Decimal   @default(0)
  guest       Boolean   @default(false)
  // Buyer-block fields for the CLASSIC template + e-Invoice BuyerDtls/ShipDtls
  // — `contact`/`phone` above already cover "Contact person"/"Contact".
  fssaiNo     String?
  pincode     String?
  invoices    Invoice[]

  @@index([companyId, guest])
}

model Invoice {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id])
  number               String
  date                 DateTime
  due                  DateTime
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  status               InvoiceStatus @default(DRAFT)
  overallDiscountType  DiscountType  @default(PERCENT)
  overallDiscountValue Decimal       @default(0)
  // Free-text, per-invoice (unlike Company.terms, which is the same on every
  // invoice) — notes prints near the totals/declaration, deliveryInstructions
  // repeats in the buyer block since it's what the delivery crew needs to see.
  notes                String?
  deliveryInstructions String?
  items                InvoiceItem[]
  payments             Payment[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // e-Invoice (NIC IRP) result — see src/lib/nic/einvoice.ts.
  irn            String?
  ackNo          String?
  ackDate        DateTime?
  signedQrCode   String?        @db.Text
  einvoiceStatus EinvoiceStatus @default(NOT_GENERATED)
  einvoiceError  String?

  // e-Way Bill inputs (user-entered transport details) + NIC result — see
  // src/lib/nic/ewaybill.ts. Independent of e-Invoice — a business can owe
  // an e-Way Bill without being e-Invoice-mandated, and vice versa.
  vehicleNo          String?
  transporterId      String?
  transporterName    String?
  transporterDocNo   String?
  transporterDocDate DateTime?
  transportMode      TransportMode  @default(ROAD)
  distanceKm         Int?
  ewbNo              String?
  ewbDate            DateTime?
  ewbValidUpto       DateTime?
  ewaybillStatus     EwaybillStatus @default(NOT_GENERATED)
  ewbError           String?

  // Standard Tally-style reference fields shown on the CLASSIC invoice's
  // header grid — all optional, blank unless the business fills them in via
  // "Edit dispatch details" (see src/actions/invoices.ts's
  // updateDispatchDetails). None of these feed GST math or the NIC payload;
  // they're print/reference fields only.
  deliveryNote     String?
  deliveryNoteDate DateTime?
  buyersOrderNo    String?
  buyersOrderDate  DateTime?
  dispatchDocNo    String?
  otherReferences  String?
  billOfLadingNo   String?
  destination      String?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Nullable — an ad-hoc/custom line item (not from the product catalog)
  // has no backing Product row. `name`/`unit`/`rate` are always
  // snapshotted here regardless, so nothing ever needs to read through
  // this relation to render an invoice.
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  name          String
  unit          String
  qty           Decimal
  rate          Decimal
  discount      Decimal  @default(0)
  // Snapshotted at invoice-creation time, same convention as name/unit/rate
  // above — CLASSIC template + HSN-wise tax summary + e-Invoice ItemList.
  hsn           String?
  batch         String?
  // Snapshotted from Product.altUnit/altQtyPerUnit — see that field's comment.
  altUnit       String?
  altQtyPerUnit Decimal?
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal
  date      DateTime
  mode      String?
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
}

enum DiscountType {
  PERCENT
  FLAT
}

enum InvoiceTemplate {
  MODERN
  CLASSIC
}

enum EinvoiceStatus {
  NOT_GENERATED
  GENERATED
  CANCELLED
  FAILED
}

enum EwaybillStatus {
  NOT_GENERATED
  GENERATED
  CANCELLED
  FAILED
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}
